SECRET_KEY=change-me-to-random
GEMINI_API_KEY=
ADMIN_EMAIL=admin@medinsight.in
ADMIN_PASSWORD=admin123
# Ollama RAG (local). Requires `ollama serve` running.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
# Single-model setup (only gemma3:1b installed): use TF-IDF retrieval, no extra pull.
# After `ollama pull nomic-embed-text` you can set OLLAMA_EMBED_MODEL=nomic-embed-text.
OLLAMA_EMBED_MODEL=tfidf
# Open-source medical vision for scans/photos (CT/X-ray/MRI). Falls back to Gemini vision.
# Single-model setup: leave as `disabled` to skip local vision (uses OCR + Gemini).
# Pull it with: ollama pull medgemma:4b  then set OLLAMA_VISION_MODEL=medgemma:4b
OLLAMA_VISION_MODEL=disabled
# Gemini fallback (tried in order). Get a key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set DISABLE_OLLAMA=1 to force mock mode
# DISABLE_OLLAMA=
